PORT=5000
NODE_ENV=development

# MongoDB
# Atlas SRV format must include the database name after the host.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/akshaygun?retryWrites=true&w=majority
MONGODB_DB_NAME=akshaygun
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
MONGODB_CONNECT_RETRIES=5
MONGODB_CONNECT_RETRY_DELAY_MS=2000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=15000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_CONNECT_TIMEOUT_MS=10000

# Auth
JWT_SECRET=replace_with_a_long_random_secret

# Optional: comma-separated frontend origins when the frontend runs on another domain.
# Example: http://localhost:5173,https://your-domain.com
CORS_ORIGIN=

# Admin login for product upload dashboard
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password

# Owner email for order confirmations
OWNER_EMAIL=owner@example.com

# Optional email service
# EMAIL_SERVICE=gmail
# EMAIL_USER=your-email@example.com
# EMAIL_PASSWORD=your-app-password
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_SECURE=false

# Seeding
FORCE_SEED=false

# Razorpay live/test keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
ALLOW_DEMO_PAYMENTS=false

# Stripe is not wired into checkout yet.
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
